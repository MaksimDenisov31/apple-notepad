<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Apple Notepad" Width="1120" Height="760" MinWidth="720" MinHeight="460" WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource Chrome}" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <SolidColorBrush x:Key="Chrome" Color="#F5F5F7"/><SolidColorBrush x:Key="Paper" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Ink" Color="#25262B"/><SolidColorBrush x:Key="Muted" Color="#83858D"/>
    <SolidColorBrush x:Key="Line" Color="#E2E3E8"/><SolidColorBrush x:Key="Accent" Color="#007AFF"/>
    <Style TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource Paper}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="13,7"/><Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#8ABEFF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Traffic" TargetType="Button"><Setter Property="Width" Value="14"/><Setter Property="Height" Value="14"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="10"/><Setter Property="Foreground" Value="#66353535"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid><Ellipse Fill="{TemplateBinding Background}"/><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource Paper}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="CaretBrush" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="Padding" Value="9,7"/><Setter Property="SelectionBrush" Value="#7FB6FF"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,12,0"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#25262B"/><Setter Property="MinHeight" Value="26"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <SolidColorBrush x:Key="MenuSurface" Color="#FAFAFC"/>
    <SolidColorBrush x:Key="MenuEdge" Color="#DCDDE2"/>
    <SolidColorBrush x:Key="MenuHover" Color="#E7E8ED"/>
    <Style TargetType="MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="9,5"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Grid SnapsToDevicePixels="True">
              <Border x:Name="MenuRow" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" MinHeight="29">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition x:Name="MarkColumn" Width="21"/><ColumnDefinition Width="*" SharedSizeGroup="MenuLabel"/><ColumnDefinition Width="Auto" SharedSizeGroup="MenuShortcut"/><ColumnDefinition x:Name="ArrowColumn" Width="12"/></Grid.ColumnDefinitions>
                  <Grid x:Name="MarkArea" VerticalAlignment="Center">
                    <ContentPresenter x:Name="MenuIcon" ContentSource="Icon" Width="15" Height="15" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="CheckMark" Text="✓" Visibility="Collapsed" FontFamily="Segoe UI Symbol" FontSize="13" VerticalAlignment="Center"/>
                  </Grid>
                  <ContentPresenter x:Name="MenuLabel" Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                  <TextBlock x:Name="ShortcutText" Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="32,0,8,0" VerticalAlignment="Center"/>
                  <Path x:Name="SubmenuArrow" Grid.Column="3" Data="M 0,0 L 4,4 L 0,8" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.3" VerticalAlignment="Center" HorizontalAlignment="Right" Visibility="Collapsed"/>
                </Grid>
              </Border>
              <Popup x:Name="PART_Popup" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Right" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" HorizontalOffset="-5" VerticalOffset="-9" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border x:Name="MenuPopupBorder" Margin="12" MinWidth="248" MaxWidth="600" CornerRadius="11" Padding="5" Background="{DynamicResource MenuSurface}" BorderBrush="{DynamicResource MenuEdge}" BorderThickness="1">
                  <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="17" ShadowDepth="3" Direction="270" Opacity="0.18"/></Border.Effect>
                  <ScrollViewer MaxHeight="620" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter Grid.IsSharedSizeScope="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/><Setter TargetName="MenuIcon" Property="Visibility" Value="Collapsed"/></Trigger>
              <Trigger Property="Role" Value="SubmenuHeader"><Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuRow" Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="White"/><Setter TargetName="ShortcutText" Property="Foreground" Value="White"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="MenuRow" Property="Opacity" Value="0.38"/></Trigger>
              <Trigger Property="Role" Value="TopLevelHeader">
                <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/><Setter TargetName="PART_Popup" Property="HorizontalOffset" Value="-12"/><Setter TargetName="PART_Popup" Property="VerticalOffset" Value="-6"/>
                <Setter TargetName="MarkColumn" Property="Width" Value="0"/><Setter TargetName="ArrowColumn" Property="Width" Value="0"/><Setter TargetName="ShortcutText" Property="Visibility" Value="Collapsed"/><Setter TargetName="MarkArea" Property="Visibility" Value="Collapsed"/>
                <Setter Property="Padding" Value="11,5"/>
              </Trigger>
              <Trigger Property="Role" Value="TopLevelItem"><Setter TargetName="MarkColumn" Property="Width" Value="0"/><Setter TargetName="ArrowColumn" Property="Width" Value="0"/><Setter TargetName="ShortcutText" Property="Visibility" Value="Collapsed"/><Setter TargetName="MarkArea" Property="Visibility" Value="Collapsed"/></Trigger>
              <MultiTrigger><MultiTrigger.Conditions><Condition Property="Role" Value="TopLevelHeader"/><Condition Property="IsHighlighted" Value="True"/></MultiTrigger.Conditions><Setter TargetName="MenuRow" Property="Background" Value="{DynamicResource MenuHover}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></MultiTrigger>
              <MultiTrigger><MultiTrigger.Conditions><Condition Property="Role" Value="TopLevelHeader"/><Condition Property="IsSubmenuOpen" Value="True"/></MultiTrigger.Conditions><Setter TargetName="MenuRow" Property="Background" Value="{DynamicResource MenuHover}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="{DynamicResource MenuEdge}" Margin="10,5"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Separator" BasedOn="{StaticResource {x:Static MenuItem.SeparatorStyleKey}}"/>
    <Style TargetType="ContextMenu">
      <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="HasDropShadow" Value="False"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
        <Border x:Name="ContextSurface" Margin="12" MinWidth="248" CornerRadius="11" Padding="5" Background="{DynamicResource MenuSurface}" BorderBrush="{DynamicResource MenuEdge}" BorderThickness="1">
          <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="17" ShadowDepth="3" Direction="270" Opacity="0.18"/></Border.Effect>
          <ScrollViewer MaxHeight="620" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><ItemsPresenter Grid.IsSharedSizeScope="True" KeyboardNavigation.DirectionalNavigation="Cycle"/></ScrollViewer>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" CornerRadius="9,9,0,0" Padding="13,9" Margin="2,5,2,0" Background="Transparent"><ContentPresenter ContentSource="Header" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Paper}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource Line}"/><Setter TargetName="TabBorder" Property="BorderThickness" Value="0,1,0,0"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TabControl"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid KeyboardNavigation.TabNavigation="Local"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TabPanel IsItemsHost="True" Margin="12,0,46,0"/><Border Grid.Row="1" Background="{DynamicResource Paper}"><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/></Border></Grid></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10">
    <Grid><Grid.RowDefinitions><RowDefinition Height="43"/><RowDefinition Height="63"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
      <Grid x:Name="TitleDrag" Background="Transparent"><StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0"><Button x:Name="CloseWindow" Style="{StaticResource Traffic}" Background="#FF6058" Content="×" ToolTip="Закрыть"/><Button x:Name="MinimizeWindow" Style="{StaticResource Traffic}" Background="#FFBD2E" Content="−" ToolTip="Свернуть"/><Button x:Name="MaximizeWindow" Style="{StaticResource Traffic}" Background="#28C840" Content="+" ToolTip="Развернуть"/></StackPanel><TextBlock Text="Apple Notepad" Foreground="{DynamicResource Ink}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock x:Name="SavedIndicator" Text="Все изменения сохранены" Foreground="{DynamicResource Muted}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0"/></Grid>
      <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"><DockPanel Margin="16,4,16,11" LastChildFill="False">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="SearchToggle" Content="⌕  Поиск" ToolTip="Найти — Ctrl+F" Margin="6,0"/><Button x:Name="SettingsButton" Content="⚙" FontSize="17" ToolTip="Настройки" Margin="4,0"/><Button x:Name="SaveButton" Content="Сохранить" Background="#007AFF" Foreground="White" BorderBrush="#007AFF" Margin="7,0,0,0" ToolTip="Сохранить — Ctrl+S"/></StackPanel>
        <Border Background="{DynamicResource Chrome}" CornerRadius="8" VerticalAlignment="Center"><Menu x:Name="MainMenu" Background="Transparent" VerticalAlignment="Center">
          <MenuItem Header="Файл"><MenuItem x:Name="FileNew" Header="Новая вкладка" InputGestureText="Ctrl+N"/><MenuItem x:Name="FileWindow" Header="Новое окно" InputGestureText="Ctrl+Shift+N"/><MenuItem x:Name="FileOpen" Header="Открыть…" InputGestureText="Ctrl+O"/><MenuItem x:Name="RecentMenu" Header="Недавние файлы"/><Separator/><MenuItem x:Name="FileSave" Header="Сохранить" InputGestureText="Ctrl+S"/><MenuItem x:Name="FileSaveAs" Header="Сохранить как…" InputGestureText="Ctrl+Shift+S"/><MenuItem x:Name="FileSaveAll" Header="Сохранить всё"/><Separator/><MenuItem x:Name="PageSetup" Header="Параметры страницы…"/><MenuItem x:Name="PrintFile" Header="Печать…" InputGestureText="Ctrl+P"/><Separator/><MenuItem x:Name="CloseTab" Header="Закрыть вкладку" InputGestureText="Ctrl+W"/><MenuItem x:Name="ExitApp" Header="Выход" InputGestureText="Alt+F4"/></MenuItem>
          <MenuItem Header="Правка"><MenuItem x:Name="Undo" Header="Отменить" InputGestureText="Ctrl+Z"/><MenuItem x:Name="Redo" Header="Повторить" InputGestureText="Ctrl+Y"/><Separator/><MenuItem x:Name="Cut" Header="Вырезать" InputGestureText="Ctrl+X"/><MenuItem x:Name="Copy" Header="Копировать" InputGestureText="Ctrl+C"/><MenuItem x:Name="Paste" Header="Вставить" InputGestureText="Ctrl+V"/><MenuItem x:Name="Delete" Header="Удалить" InputGestureText="Del"/><MenuItem x:Name="SelectAll" Header="Выделить всё" InputGestureText="Ctrl+A"/><Separator/><MenuItem x:Name="Find" Header="Найти…" InputGestureText="Ctrl+F"/><MenuItem x:Name="FindNext" Header="Найти далее" InputGestureText="F3"/><MenuItem x:Name="FindPrevious" Header="Найти ранее" InputGestureText="Shift+F3"/><MenuItem x:Name="Replace" Header="Заменить…" InputGestureText="Ctrl+H"/><MenuItem x:Name="GoTo" Header="Перейти к строке…" InputGestureText="Ctrl+G"/><Separator/><MenuItem x:Name="DateTime" Header="Время и дата" InputGestureText="F5"/></MenuItem>
          <MenuItem Header="Формат"><MenuItem x:Name="WordWrap" Header="Перенос по словам" IsCheckable="True"/><MenuItem x:Name="FontMenu" Header="Шрифт…"/><MenuItem x:Name="SpellcheckMenu" Header="Проверка орфографии" IsCheckable="True"/><Separator/><MenuItem x:Name="BoldMarkdown" Header="Markdown: полужирный" InputGestureText="Ctrl+B"/><MenuItem x:Name="ItalicMarkdown" Header="Markdown: курсив" InputGestureText="Ctrl+I"/><MenuItem x:Name="LinkMarkdown" Header="Markdown: ссылка…"/><MenuItem x:Name="HeadingMarkdown" Header="Markdown: заголовок"/><MenuItem x:Name="ListMarkdown" Header="Markdown: список"/></MenuItem>
          <MenuItem Header="Вид"><MenuItem x:Name="ZoomIn" Header="Увеличить" InputGestureText="Ctrl +"/><MenuItem x:Name="ZoomOut" Header="Уменьшить" InputGestureText="Ctrl −"/><MenuItem x:Name="ZoomReset" Header="Масштаб 100%" InputGestureText="Ctrl+0"/><Separator/><MenuItem x:Name="LineNumbers" Header="Номера строк" IsCheckable="True"/><MenuItem x:Name="StatusBarMenu" Header="Строка состояния" IsCheckable="True"/><MenuItem x:Name="MarkdownPreview" Header="Предпросмотр Markdown" IsCheckable="True"/><MenuItem x:Name="Fullscreen" Header="Полный экран" InputGestureText="F11"/><Separator/><MenuItem x:Name="LightTheme" Header="Светлая тема" IsCheckable="True"/><MenuItem x:Name="DarkTheme" Header="Тёмная тема" IsCheckable="True"/></MenuItem>
          <MenuItem Header="Справка"><MenuItem x:Name="HelpMenu" Header="Горячие клавиши"/><MenuItem x:Name="AboutMenu" Header="О программе"/></MenuItem>
        </Menu></Border>
      </DockPanel></Border>
      <Border x:Name="FindBar" Grid.Row="2" Background="{DynamicResource Chrome}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="20,10" Visibility="Collapsed"><StackPanel>
        <DockPanel LastChildFill="True"><Button x:Name="FindClose" DockPanel.Dock="Right" Content="×" Margin="8,0,0,0" ToolTip="Закрыть поиск — Esc"/><Button x:Name="FindNextButton" DockPanel.Dock="Right" Content="↓" Margin="5,0" ToolTip="Найти далее"/><Button x:Name="FindPrevButton" DockPanel.Dock="Right" Content="↑" Margin="5,0" ToolTip="Найти ранее"/><TextBox x:Name="FindText" ToolTip="Что найти"/></DockPanel>
        <DockPanel x:Name="ReplaceRow" Margin="0,8,0,0" Visibility="Collapsed" LastChildFill="True"><Button x:Name="ReplaceAllButton" DockPanel.Dock="Right" Content="Заменить всё" Margin="5,0,0,0"/><Button x:Name="ReplaceButton" DockPanel.Dock="Right" Content="Заменить" Margin="5,0"/><TextBox x:Name="ReplaceText" ToolTip="Чем заменить"/></DockPanel>
        <WrapPanel Margin="0,10,0,0"><CheckBox x:Name="MatchCase" Content="Учитывать регистр"/><CheckBox x:Name="WholeWord" Content="Слово целиком"/><CheckBox x:Name="WrapSearch" Content="По кругу" IsChecked="True"/><TextBlock x:Name="SearchResult" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/></WrapPanel>
      </StackPanel></Border>
      <Grid Grid.Row="3"><TabControl x:Name="Documents" BorderThickness="0"/><Button x:Name="AddTab" Content="+" FontSize="20" Padding="7,0" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,12,0" ToolTip="Новая вкладка — Ctrl+N"/></Grid>
      <Border x:Name="StatusArea" Grid.Row="4" Background="{DynamicResource Chrome}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"><DockPanel Margin="20,0"><TextBlock x:Name="PositionStatus" DockPanel.Dock="Left" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="ZoomMinus" Content="−" Padding="5,0" Width="24" Height="23" BorderThickness="0" Background="Transparent"/><TextBlock x:Name="ZoomStatus" Text="100%" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" Width="42" TextAlignment="Center"/><Button x:Name="ZoomPlus" Content="+" Padding="5,0" Width="24" Height="23" BorderThickness="0" Background="Transparent"/><ComboBox x:Name="NewlineChoice" Width="128" Margin="12,0,10,0" ToolTip="Окончания строк"><ComboBoxItem Content="Windows (CRLF)" Tag="CRLF"/><ComboBoxItem Content="Unix (LF)" Tag="LF"/><ComboBoxItem Content="Mac (CR)" Tag="CR"/></ComboBox><ComboBox x:Name="EncodingChoice" Width="116" ToolTip="Кодировка при сохранении"><ComboBoxItem Content="UTF-8" Tag="utf8"/><ComboBoxItem Content="UTF-8 с BOM" Tag="utf8bom"/><ComboBoxItem Content="UTF-16 LE" Tag="utf16"/><ComboBoxItem Content="UTF-16 BE" Tag="utf16be"/><ComboBoxItem Content="UTF-32 LE" Tag="utf32"/><ComboBoxItem Content="UTF-32 BE" Tag="utf32be"/><ComboBoxItem Content="ANSI" Tag="ansi"/></ComboBox></StackPanel></DockPanel></Border>
    </Grid>
  </Border>
</Window>
